      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import nashpy as nash\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.colors as mcolors\n",
        "\n",
        "class ValidatorGame:\n",
        "    def __init__(self, reward, mev_bribe, slashing_penalty, missed_reward=0):\n",
        "        self.actions = ['Stake', 'Defect']\n",
        "\n",
        "        # Player A (Row) Payoffs\n",
        "        self.P1_payoffs = np.array([\n",
        "            [reward, missed_reward],\n",
        "            [mev_bribe, slashing_penalty]\n",
        "        ])\n",
        "\n",
        "        # Player B (Column) Payoffs\n",
        "        self.P2_payoffs = np.array([\n",
        "            [reward, mev_bribe],\n",
        "            [missed_reward, slashing_penalty]\n",
        "        ])\n",
        "\n",
        "        # Initialize the game environment\n",
        "        self.game = nash.Game(self.P1_payoffs, self.P2_payoffs)\n",
        "\n",
        "    def find_equilibria(self):\n",
        "        # Calculate and return all Nash Equilibria strategies\n",
        "        return list(self.game.support_enumeration())\n",
        "\n",
        "    def plot_heatmap(self):\n",
        "        fig, ax = plt.subplots(figsize=(6, 6))\n",
        "\n",
        "        # Calculate combined payoffs for the heatmap colors\n",
        "        social_welfare = self.P1_payoffs + self.P2_payoffs\n",
        "\n",
        "        # Color mapping: Red for negative outcomes, Green for positive\n",
        "        cmap = mcolors.LinearSegmentedColormap.from_list(\"rg\", [\"#ff4c4c\", \"#e5e5e5\", \"#4caf50\"])\n",
        "        norm = mcolors.TwoSlopeNorm(vmin=social_welfare.min() - 1, vcenter=0, vmax=social_welfare.max() + 1)\n",
        "\n",
        "        ax.imshow(social_welfare, cmap=cmap, norm=norm)\n",
        "\n",
        "        # Annotate each cell with the exact (Player A, Player B) payoffs\n",
        "        for i in range(2):\n",
        "            for j in range(2):\n",
        "                text = f\"({self.P1_payoffs[i, j]}, {self.P2_payoffs[i, j]})\"\n",
        "                ax.text(j, i, text, ha=\"center\", va=\"center\", color=\"black\", fontsize=12, fontweight='bold')\n",
        "\n",
        "        # Formatting the axes\n",
        "        ax.set_xticks(np.arange(2))\n",
        "        ax.set_yticks(np.arange(2))\n",
        "        ax.set_xticklabels(self.actions)\n",
        "        ax.set_yticklabels(self.actions)\n",
        "        ax.xaxis.tick_top()\n",
        "        ax.set_xlabel('Validator B', fontsize=12, labelpad=10)\n",
        "        ax.set_ylabel('Validator A', fontsize=12, labelpad=10)\n",
        "        ax.set_title('Validator Payoff Matrix & Social Welfare', pad=20, fontweight='bold')\n",
        "\n",
        "        plt.show()\n"
      ],
