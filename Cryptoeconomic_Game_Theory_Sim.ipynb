        "# Test scenario: High MEV bribe, devastating slashing penalty\n",
        "simulator = ValidatorGame(\n",
        "    reward=5,\n",
        "    mev_bribe=10,\n",
        "    slashing_penalty=-15,\n",
        "    missed_reward=0\n",
        ")\n",
        "\n",
        "# 1. Print the mathematical probabilities\n",
        "print(\"--- Nash Equilibria ---\")\n",
        "equilibria = simulator.find_equilibria()\n",
        "for idx, eq in enumerate(equilibria):\n",
        "    p1_prob, p2_prob = eq\n",
        "    print(f\"Equilibrium {idx + 1}:\")\n",
        "    print(f\"  Validator A: Stake ({p1_prob[0]:.0%}), Defect ({p1_prob[1]:.0%})\")\n",
        "    print(f\"  Validator B: Stake ({p2_prob[0]:.0%}), Defect ({p2_prob[1]:.0%})\\n\")\n",
        "\n",
        "# 2. Render the visual\n",
        "simulator.plot_heatmap()"
